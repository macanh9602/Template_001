{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review/v1",
  "title": "Independent review (fresh read-only invocation; reviewer != implementer)",
  "type": "object",
  "required": ["schema", "taskId", "round", "reviewer", "verdict", "findings"],
  "properties": {
    "schema": { "const": "review/v1" },
    "taskId": { "type": "string" },
    "round": { "type": "integer", "minimum": 1 },
    "reviewer": { "type": "string" },
    "reviewedBase": { "type": "string" },
    "targetRef": { "type": ["string", "null"] },
    "verdict": { "enum": ["PASS", "PATCH", "TARGET_RECONSIDER", "BLOCKED"] },
    "summary": { "type": "string" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object", "required": ["area", "observed", "expected", "evidence"],
        "properties": {
          "area": { "type": "string" },
          "observed": { "type": "string" },
          "expected": { "type": "string", "description": "Acceptance item or target clause." },
          "evidence": { "type": "string" },
          "patch": {
            "type": ["object", "null"],
            "properties": { "field": { "type": "string" }, "from": {}, "to": {}, "instruction": { "type": "string" } }
          }
        }
      }
    },
    "implHypothesesRuledOut": {
      "type": "array", "items": { "type": "string" },
      "description": "Required non-empty for TARGET_RECONSIDER; otherwise the runner downgrades it to BLOCKED(impl-unknown)."
    }
  }
}
